{
    "server_port": ":8081",
    "db_path": "xxl_job.db",
    "gin_mode": "release",
    "access_token": "default_token",
    "app_name": "xxl-job-executor-sample",
    "http_timeout": 5,
    "registry_scan_interval": 10,
    "registry_timeout": 90,
    "scheduler_interval": 1,
    "mq_enabled": true,
    "mq_url": "amqp://guest:guest@localhost:5672/",
    "mq_queue": "xxl.job.tasks",
     "redis_enabled": true,
    "redis_addr": "localhost:6379",
    "redis_password": "myredispassword"
}
